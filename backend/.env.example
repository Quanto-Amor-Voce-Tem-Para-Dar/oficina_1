# Copie este arquivo para .env e preencha. O .env NÃO vai para o Git.

# ---------- Servidor ----------
PORTA=3000
# Endereço do front (CORS e retorno do login do Google). Vários: separe por vírgula.
FRONTEND_URL=http://localhost:5173

# ---------- Banco de dados (MySQL 8) ----------
# Local com o docker-compose da raiz do projeto:
DB_HOST=localhost
DB_PORTA=3306
DB_USUARIO=root
DB_SENHA=root
DB_NOME=quanto_amor
# Banco na nuvem (Aiven, TiDB Cloud...): use a URL completa e ligue o SSL.
# DATABASE_URL=mysql://usuario:senha@host:porta/banco
# DB_SSL=true

# ---------- Login dos usuários ----------
# Texto longo e aleatório. Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-texto-grande-e-aleatorio
# Administrador criado na primeira vez que o servidor sobe
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@quantoamor.com
ADMIN_SENHA=admin123

# ---------- Google Calendar (opcional) ----------
# Opção 1 (local): coloque o credentials.json na pasta backend/.
# Opção 2 (Vercel): preencha as duas variáveis abaixo.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Precisa estar cadastrada como "URI de redirecionamento autorizado" no Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth2callback

# ---------- E-mail / SMTP (opcional) ----------
# Gmail: crie uma "senha de app" em https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=465
# SMTP_USUARIO=seu.email@gmail.com
# SMTP_SENHA=senha-de-app-de-16-letras
# SMTP_REMETENTE="Quanto Amor Você Tem Para Dar? <seu.email@gmail.com>"
